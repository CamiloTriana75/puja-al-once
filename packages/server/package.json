{
  "name": "@fut/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "pnpm --filter @fut/shared exec tsc -p tsconfig.build.json && tsc -p tsconfig.build.json",
    "start:dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.16.25",
    "@colyseus/monitor": "0.16.7",
    "@colyseus/schema": "3.0.76",
    "@colyseus/tools": "0.16.20",
    "@colyseus/ws-transport": "0.16.5",
    "@fut/shared": "workspace:*",
    "colyseus": "0.16.5",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@colyseus/testing": "0.16.3",
    "@types/express": "5.0.5",
    "@types/node": "26.4.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
