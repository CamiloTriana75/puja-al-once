node_modules/
dist/
.env
test-results/
playwright-report/
.superpowers/
*.log

# Restos de compilar tests por error (ver tsconfig.build.json)
packages/*/test/*.js

# Indice local de graphify (rutas absolutas, cache de extraccion)
graphify-out/

# Estado local de herramientas. Nada de esto es del proyecto: son caches,
# worktrees y skills del agente que se regeneran solas y solo ensucian el repo
# si se suben. .claude/ entera queda fuera del remoto (los ficheros siguen en
# el disco de quien los tenga, solo dejan de versionarse).
.playwright-mcp/
.claude/
.mcp.json
.playwright/
.cursor/
.vscode/

# Capturas de QA de la propia sesion (ver CREDITS.md para las fotos del juego,
# que si son parte del dataset y van versionadas en data/photos).
/auction-*.png
/landing-*.png
/lobby-*.png
/reaction-*.png

# Hojas de contactos para revisar las siluetas a ojo (scripts/contact-sheet.ts).
# Artefacto de revision local, se regenera solo.
/contact-sheets/

# Herramientas de agentes de IA (skills, agentes, hooks, estado de Impeccable).
# Son locales de cada maquina, no parte del proyecto.
.agent/
.github/agents/
.github/hooks/
.github/skills/
.impeccable/
