{
  "name": "fut",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "test": "pnpm -r test && pnpm test:tools",
    "test:tools": "vitest run tools",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dataset:check": "tsx scripts/check-dataset.ts",
    "silhouettes:build": "tsx tools/build-silhouettes.ts",
    "silhouettes:audit": "tsx scripts/audit-silhouettes.ts",
    "silhouettes:normalize": "tsx scripts/normalize-silhouettes.ts",
    "silhouettes:sheet": "tsx scripts/contact-sheet.ts",
    "silhouettes:sheet:check": "tsx scripts/check-contact-sheet.ts",
    "silhouettes:candidates": "tsx scripts/candidate-sheet.ts",
    "silhouettes:candidates:thumbs": "tsx scripts/fetch-candidate-thumbs.ts",
    "og:assets": "node tools/build-logo.cjs tools/brand/logo-source.png && python tools/build-og-image.py"
  },
  "devDependencies": {
    "@fut/shared": "workspace:*",
    "@imgly/background-removal-node": "1.4.5",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.1",
    "sharp": "0.32.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.32.6",
      "@colyseus/greeting-banner": "^2.0.6"
    }
  }
}
