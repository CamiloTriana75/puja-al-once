{
  "name": "pujaelonce-trailer",
  "private": true,
  "version": "0.0.0",
  "description": "Trailer vertical de Puja el Once (Remotion). No forma parte del workspace pnpm.",
  "type": "module",
  "scripts": {
    "assets": "node scripts/sync-assets.mjs && python scripts/prepare-images.py && python scripts/make-audio.py",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Trailer out/puja-el-once-trailer.mp4 --codec=h264 --crf=18",
    "render:sin-musica": "remotion render src/index.ts Trailer out/puja-el-once-trailer-sin-musica.mp4 --codec=h264 --crf=18 --props={\\\"music\\\":false}",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.532",
    "@remotion/fonts": "^4.0.532",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.532"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^6.0.3"
  }
}
