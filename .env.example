# Opcional cuando cliente y servidor usan el mismo origen.
# Si se separan, indica uno o varios origenes del frontend separados por coma.
PUBLIC_ORIGINS=

# Opcional para compilar el cliente contra un servidor alojado en otro host.
# VITE_SERVER_URL=https://api.tudominio.com

# Opcional. URL publica del sitio, para canonical, og:url, sitemap y
# robots. Si no la pones, el build usa el valor por defecto de
# packages/client/vite.config.ts. Solo hace falta si el dominio cambia.
# VITE_SITE_URL=https://subasta-futbolera.onrender.com
